# Local development (npm run dev). Copy to server/.env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
MONGO_URI=mongodb://127.0.0.1:27017/triagex
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# Secrets: dev defaults are used when unset; REQUIRED (and must differ from defaults) in production
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AUDIT_SIGNING_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Set COOKIE_SECURE=true and COOKIE_SAMESITE=none when the client is served from another site over HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ML service
ML_URL=http://127.0.0.1:8000
ML_API_KEY=
ML_TIMEOUT_MS=2500
# Auto-apply the AI priority when its confidence is at least this value
AI_AUTO_APPLY_CONFIDENCE=0.6

# SLA scheduler (node-cron syntax with seconds)
ENABLE_SCHEDULER=true
SLA_SCAN_CRON=*/30 * * * * *
SLA_AT_RISK_RATIO=0.75
AUTO_ASSIGN_ON_BREACH=true

# Alert ingestion key (x-alert-key header)
ALERT_INGEST_KEY=

# Optional LLM postmortems: none | openai (any OpenAI-compatible endpoint via LLM_BASE_URL) | anthropic
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30
