# Leave empty in development: Vite proxies /api and /socket.io to VITE_DEV_API.
VITE_DEV_API=http://localhost:4000
# Production builds: base URL of the API if it is not served from the same origin
# (on Vercel, /api is rewritten to the API, so leave VITE_API_URL empty).
VITE_API_URL=
# Socket.IO cannot go through Vercel rewrites; point it straight at the API host.
VITE_SOCKET_URL=
