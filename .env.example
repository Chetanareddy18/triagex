# Used by docker compose. Copy to .env and replace every value marked CHANGE ME.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE-ME-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=CHANGE-ME-refresh-secret-at-least-32-characters
AUDIT_SIGNING_KEY=CHANGE-ME-audit-hmac-key-at-least-32-characters

# Optional shared secret between API and ML service
ML_API_KEY=
# true = build the ML image with sentence-transformers (semantic embeddings, ~1 GB larger)
ML_WITH_TRANSFORMERS=false
EMBEDDING_BACKEND=auto

# Optional: key for POST /api/alerts/ingest (x-alert-key header)
ALERT_INGEST_KEY=

# Optional LLM postmortem drafts: none | openai | anthropic
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
